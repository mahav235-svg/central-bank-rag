# Copy to .env and fill in what you use. Never commit .env.

# Which model answers: anthropic | openai | ollama
CBRAG_PROVIDER=anthropic

# Anthropic (default model claude-opus-5-5)
ANTHROPIC_API_KEY=
# CBRAG_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
# CBRAG_OPENAI_MODEL=gpt-5

# Ollama (local, no key)
# CBRAG_OLLAMA_MODEL=qwen2.5:7b-instruct
# CBRAG_OLLAMA_URL=http://localhost:11434

# Use a Qdrant server instead of the embedded on-disk store
# CBRAG_QDRANT_URL=http://localhost:6333

# What happens to answers that fail a check: queue (write to data/review_queue.jsonl) | interrupt (pause the run)
CBRAG_REVIEW_MODE=queue

# Identify yourself to the Fed and RBI servers when downloading
CBRAG_USER_AGENT=central-bank-rag/0.1 (personal research; github.com/mahav235-svg)
